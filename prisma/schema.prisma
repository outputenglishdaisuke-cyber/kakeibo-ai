// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  color        String        @default("#6366f1")
  icon         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  rules        Rule[]
  budget       CategoryBudget?
}

model Transaction {
  id          String    @id @default(cuid())
  date        DateTime
  description String
  amount      Int
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  source      Source    @default(MANUAL)
  memo        String?
  confirmed   Boolean   @default(false)
  /** レシート集約で親に取り込まれた旧品目行。一覧・集計から除外 */
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /** 支払方法（レシート・手入力のみ。カード明細は null） */
  paymentMethod    PaymentMethod?
  /** カード明細とレシートの突合状態 */
  reconcileStatus  ReconcileStatus @default(unmatched)
  /** 現金の根拠。confirmed=入力/OCRで判明、auto=突合できず自動で現金扱い */
  cashSource       CashSource?
  /** 突合結果の目視確認用の印。突合の成否には影響しない */
  needsReview      Boolean         @default(false)
  /** 同一レシートの品目行に共通のID（品目分割で保存した場合） */
  receiptGroupId   String?
  /** カード明細側: 突合したレシートの単位ID（単独行は Transaction.id、品目分割は receiptGroupId） */
  matchedReceiptId String?
  /** レシート側: 突合したカード明細の Transaction.id */
  matchedCardId    String?
  /** 現金への自動判定から除外する（カード明細の画像、手動でカード扱いに戻したもの） */
  autoCashExempt   Boolean         @default(false)
  /** 手動で紐付けを解除したカード明細。同じ組では再突合しない */
  rejectedCardIds  String[]        @default([])
  /** Unknown の削除（ソフト削除）。一覧・集計から除外 */
  deletedAt        DateTime?
  /** レシート側: 未突合の理由 */
  unmatchedReason  UnmatchedReason?
  /** カード明細側: どのCSV取込に属するか */
  importBatchId    String?
  importBatch      CardImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  /** CSV取込の重複判定用。同じ日付・店名・金額の明細が同じCSVに複数ある場合の何件目か */
  dupIndex         Int             @default(0)

  @@index([date])
  @@index([categoryId])
  @@index([archived])
  @@index([reconcileStatus])
  @@index([matchedCardId])
  @@index([receiptGroupId])
  @@index([importBatchId])
  @@unique([date, description, amount, dupIndex])
}

/**
 * カードCSVの取込1回分（ファイル単位）。
 * 利用日の範囲は、含まれる明細の利用日から算出する（ファイル名・支払月からは算出しない）。
 */
model CardImportBatch {
  id            String        @id @default(cuid())
  fileName      String?
  /** 列の位置の設定（csv-formats.ts の id）。AI・自動推定で読んだ場合は null */
  format        String?
  /** 支払月（YYYY-MM）。表示用で、月・期間の判定には使わない */
  paymentMonth  String?
  rowCount      Int           @default(0)
  coverageStart DateTime?
  coverageEnd   DateTime?
  createdAt     DateTime      @default(now())
  transactions  Transaction[]
}

/**
 * カード明細の店名とレシートの店名が同じ店かの判定結果（AI またはユーザー）。
 * 名前は正規化済みの値で保持し、次回以降の突合と AI への判断材料に使う。
 */
model StoreMatchJudgement {
  id            String            @id @default(cuid())
  cardName      String
  receiptName   String
  /** 表示用の元の表記 */
  cardSample    String
  receiptSample String
  verdict       StoreMatchVerdict
  source        StoreMatchSource
  confidence    Float?
  /** AI が調べたカード明細の実店舗 */
  merchant      String?
  reason        String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([cardName, receiptName])
}

model Rule {
  id         String   @id @default(cuid())
  keyword    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([keyword])
}

/** アプリ全体の設定（レイアウトなど）。認証なしのため key 単位で1件保存 */
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/** 月次のカテゴリ別予算。行がないカテゴリ（家賃など）は予算比較の対象外 */
model CategoryBudget {
  categoryId   String   @id
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  targetAmount Int
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
}

enum Source {
  CSV
  MANUAL
  IMAGE
}

enum PaymentMethod {
  credit_card
  cash
  unknown
}

/** カード明細: unmatched / matched / fallback_split、レシート: unmatched / matched / cash。unknown は返金・調整 */
enum ReconcileStatus {
  unmatched
  matched
  fallback_split
  cash
  unknown
}

enum CashSource {
  confirmed
  auto
}

/** no_csv_coverage=前後に取込済みのカード明細が無い、no_candidate=明細はあるが候補が無い */
enum UnmatchedReason {
  no_csv_coverage
  no_candidate
}

enum StoreMatchVerdict {
  same
  different
  undetermined
}

enum StoreMatchSource {
  ai
  user
}
